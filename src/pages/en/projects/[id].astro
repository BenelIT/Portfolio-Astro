---
import "../../../styles/global.css";

import Layout from "@/layouts/Layout.astro";
import BgAnimated from "@/layouts/BgAnimated.astro";
import { FloatingLanguageSwitcher } from "@/components/shared/FloatingLanguageSwitcher";
import {
  getProjectById,
  getProjectIds,
} from "@/components/sections/projects/data/Projects.data";
import { ProjectDetailPage } from "@/components/sections/projects/components/Projectdetail";

export function getStaticPaths() {
  return getProjectIds().map((id) => ({
    params: { id: String(id) },
    props: { id },
  }));
}

const { id } = Astro.props;
const project = getProjectById(id, "en");

if (!project) {
  throw new Error(`Project not found: ${id}`);
}
---

<Layout locale="en">
  <BgAnimated>
    <ProjectDetailPage
      project={project}
      locale="en"
      onBack="/en"
      switchToPath={`/projects/${project.id}`}
      client:load
    />
    <FloatingLanguageSwitcher
      locale="en"
      switchToPath={`/projects/${project.id}`}
      client:idle
    />
  </BgAnimated>
</Layout>
