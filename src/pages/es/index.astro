---
import { Toaster } from "sonner";

import "../../styles/global.css";

import { Navbar } from "@/layouts/Navbar";
import BgAnimated from "@/layouts/BgAnimated.astro";
import Layout from "@/layouts/Layout.astro";
import { FloatingLanguageSwitcher } from "@/components/shared/FloatingLanguageSwitcher";
import Hero from "@/components/sections/hero/Hero.astro";
import AboutSection from "@/components/sections/about/AboutSection.astro";
import ProjectsSection from "@/components/sections/projects/ProjectsSection.astro";
import ContactSection from "@/components/sections/contact/ContactSection.astro";
import Footer from "@/layouts/Footer.astro";
---

<Layout locale="es">
  <BgAnimated>
    <Navbar locale="es" switchToPath="/" client:idle />
    <Hero locale="es" />
    <AboutSection locale="es" />
    <ProjectsSection locale="es" />
    <ContactSection locale="es" />
    <Footer locale="es" />
    <FloatingLanguageSwitcher locale="es" switchToPath="/" client:idle />
  </BgAnimated>
  <Toaster client:idle richColors position="top-left" />
</Layout>
