---
import { normalizeLocale } from "@/i18n/config";
import type { Locale } from "@/i18n/types";

interface Props {
  locale?: Locale;
}

const locale = normalizeLocale(Astro.props.locale);
const t =
  locale === "es"
    ? {
        copy: "Todos los derechos reservados.",
      }
    : {
        copy: "All rights reserved.",
      };
---

<footer class="relative px-6 md:px-10">
  <div class="p-8 md:p-12">
    {/* Divider */}
    <div
      class="my-8 h-px bg-linear-to-r from-transparent via-white/50 to-transparent"
    >
    </div>

    {/* Copyright */}
    <div class="text-center text-sm text-slate-600">
      <p>
        © {new Date().getFullYear()} Cristobal De Jesus Coronel Chambe. {t.copy}
      </p>
    </div>
  </div>
</footer>
