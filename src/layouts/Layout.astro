---
import { getDictionary } from "@/i18n/dictionary";
import { normalizeLocale } from "@/i18n/config";
import type { Locale } from "@/i18n/types";

interface Props {
  locale?: Locale;
}

const locale = normalizeLocale(Astro.props.locale);
const dict = getDictionary(locale);
const ogLocale = locale === "es" ? "es_ES" : "en_US";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{dict.seo.title}</title>

    <meta name="description" content={dict.seo.description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://cristobalchambe.netlify.app/" />

    <meta property="og:title" content={dict.seo.title} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:description" content={dict.seo.description} />
    <meta
      property="og:image"
      content="https://cristobalchambe.netlify.app/og.png"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@BenelNY" />
    <meta name="twitter:title" content={dict.seo.title} />
    <meta name="twitter:description" content={dict.seo.description} />

    <script is:inline>
      (() => {
        const preferred = window.localStorage.getItem("preferred-language");
        const path = window.location.pathname;

        // Si no hay preferencia guardada, asegurar que esté en inglés (/) por defecto
        if (!preferred) {
          if (path.startsWith("/es")) {
            window.location.replace(path.replace(/^\/es/, "") || "/");
            return;
          }
          window.localStorage.setItem("preferred-language", "en");
          return;
        }

        // Si prefiere español, asegurar que esté en /es
        if (preferred === "es" && !path.startsWith("/es")) {
          window.location.replace(path === "/" ? "/es" : `/es${path}`);
          return;
        }

        // Si prefiere inglés, asegurar que NO esté en /es
        if (preferred === "en" && path.startsWith("/es")) {
          window.location.replace(path.replace(/^\/es/, "") || "/");
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
