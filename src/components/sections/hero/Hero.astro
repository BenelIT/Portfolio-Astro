---
import { Button } from "@/components/ui/button";
import { scrollToSection } from "@/utils/scrollToSection";
import { ArrowRight, Layers } from "lucide-react";
import img1 from "@/assets/about-me/img1.jpeg";
import { normalizeLocale } from "@/i18n/config";
import type { Locale } from "@/i18n/types";

interface Props {
  locale?: Locale;
}

const locale = normalizeLocale(Astro.props.locale);
const t =
  locale === "es"
    ? {
        openToOpportunities: "Abierto a oportunidades",
        titleMain: "Desarrollador de software",
        titleHighlight: "Claro · Flexible · Confiable",
        description:
          "Construyo software con claridad e intención, enfocándome en la mantenibilidad a largo plazo y en las necesidades reales del usuario. Exploro diferentes enfoques antes de comprometerme con uno, y me importa profundamente que las cosas sean fáciles de entender, modificar y confiar.",
        cta: "Explora mi trabajo",
        collaboration: "Colaboración real en proyectos full-stack",
        available: "Disponible",
      }
    : {
        openToOpportunities: "Open to opportunities",
        titleMain: "Software developer",
        titleHighlight: "Clear · Flexible · Reliable",
        description:
          "I build software with clarity and intention, focusing on long-term maintainability and real user needs. I explore different approaches before committing to one, and I deeply care that things are easy to understand, modify, and trust.",
        cta: "Explore my work",
        collaboration: "Real collaboration in full-stack projects",
        available: "Available",
      };
---

<section id="hero" class="animate-blurred-fade-in">
  {/* Badge */}
  <div class="text-center mt-20 sm:mt-20 md:mt-28 px-4">
    <div
      class="inline-flex items-center gap-2 px-4 py-2 backdrop-blur-xl bg-white/30 rounded-full text-sm font-medium blur-shadow-md"
    >
      <span class="relative flex">
        <span
          class="animate-ping absolute h-full w-full rounded-full bg-blue-400 opacity-75"
        ></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-600"
        ></span>
      </span>
      {t.openToOpportunities}
    </div>
  </div>

  <div
    class="flex flex-col lg:flex-row items-center mt-8 sm:mt-12 gap-8 lg:gap-12 px-4 sm:px-6 md:px-10"
  >
    {/* Content */}
    <div class="flex-1 w-full">
      {/* title */}
      <h1
        class="text-3xl sm:text-3xl md:text-4xl lg:text-4xl xl:text-6xl font-bold text-neutral-900 leading-tight tracking-tight"
      >
        {t.titleMain}
        <br />
        <span class="text-blue-600"> {t.titleHighlight}</span>
      </h1>

      {/* Description */}
      <p
        class="mt-2 text-lg sm:text-base md:text-lg lg:text-xl max-w-3xl leading-relaxed text-neutral-600 dark:text-neutral-300"
      >
        {t.description}
      </p>
      {/* CTA Section */}
      <div class="mt-5 sm:mt-6 md:mt-7 lg:mt-8">
        <Button
          size="lg"
          id="explore-btn"
          className="bg-blue-600 hover:bg-blue-700 text-white shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-0.5 w-full sm:w-auto "
        >
          {t.cta}
          <ArrowRight
            className="ml-2 h-4 w-4 transition-transform group-hover:translate-x-1"
          />
        </Button>
        <p
          class="flex items-center justify-center sm:justify-start text-xs sm:text-sm mt-3 gap-2 text-black/60 font-bold tracking-wide"
        >
          <Layers className="w-3.5 h-3.5 sm:w-4 sm:h-4 text-blue-600" />
          {t.collaboration}
        </p>
      </div>
    </div>

    <!-- Hidden Div on Mobile Devices -->
    <div
      class="hidden lg:flex justify-center items-center shrink-0 mb-20 mr-10"
    >
      <div class="relative">
        {/* Anillo decorativo exterior */}
        <div
          class="absolute inset-0 rounded-full bg-linear-to-br from-blue-400 via-blue-600 to-blue-950 p-0.75 scale-105 opacity-40 blur-sm"
        >
        </div>

        {/* Anillo principal */}
        <div
          class="relative rounded-full bg-linear-to-br from-blue-400 via-blue-600 to-blue-950 p-0.75"
        >
          <div
            class="rounded-full overflow-hidden w-56 h-56 xl:w-64 xl:h-64 bg-white"
          >
            <img
              src={img1.src}
              alt="Cristobal"
              class="w-full h-full object-cover object-top"
            />
          </div>
        </div>

        {/* Badge flotante */}
        <div
          class="absolute -bottom-3 -right-3 bg-white rounded-2xl px-3 py-2 shadow-lg border border-white/60 backdrop-blur-sm flex items-center gap-2"
        >
          <span class="relative flex">
            <span
              class="animate-ping absolute h-full w-full rounded-full bg-blue-400 opacity-75"
            ></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-600"
            ></span>
          </span>
          <span class="text-xs font-semibold text-neutral-700"
            >{t.available}</span
          >
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { scrollToSection } from "@/utils/scrollToSection";
  document.getElementById("explore-btn")?.addEventListener("click", () => {
    scrollToSection("#projects");
  });
</script>
