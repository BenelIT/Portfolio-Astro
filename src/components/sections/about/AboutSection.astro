---
import { Code2, Layers, ShieldCheck, UserCheck } from "lucide-react";

import AboutCTA from "./components/AboutCTA.astro";
import { backendTechStack, frontendTechStack } from "./data/techStackData";
import ProfileHeader from "@/components/shared/ProfileHeader.astro";
import { TechStackCarousel } from "./components/TechStackCarousel";
import { normalizeLocale } from "@/i18n/config";
import type { Locale } from "@/i18n/types";

interface Props {
  locale?: Locale;
}

const locale = normalizeLocale(Astro.props.locale);
const t =
  locale === "es"
    ? {
        title: "Sobre mí",
        paragraph1:
          "Me importa mucho cómo se lee el código, no solo cómo funciona. Como valoro el trabajo en equipo, prefiero escribir código claro y mantenible que otros puedan entender fácilmente, incluso si eso significa priorizar la legibilidad en lugar de ahorrar unas cuantas líneas.",
        paragraph2:
          "Trabajo en todo el stack, pero me atrae especialmente el frontend porque es donde el usuario siente el producto. Disfruto pensar en los flujos y en los pequeños detalles que hacen que las cosas sean más fáciles y naturales para quienes usan lo que construimos.",
        reliability: "Confiabilidad",
        longTermThinking: "Pensamiento a largo plazo",
        userCentered: "Enfoque centrado en el usuario",
        backendTools: "Backend y herramientas",
        frontend: "Frontend",
      }
    : {
        title: "About me",
        paragraph1:
          "I care deeply about how code is read, not just how it runs. Since I value teamwork, I prefer writing clear and maintainable code that others can easily understand, even if that means prioritizing readability over saving a few lines.",
        paragraph2:
          "I work across the full stack, but I am especially drawn to frontend work because that is where users feel the product. I enjoy thinking through flows and small details that make experiences easier and more natural for people using what we build.",
        reliability: "Reliability",
        longTermThinking: "Long-term thinking",
        userCentered: "User-centered focus",
        backendTools: "Backend and tooling",
        frontend: "Frontend",
      };
---

<section
  id="about"
  class="px-4 sm:px-6 md:px-8 lg:px-10 my-16 sm:my-20 md:my-32 animate-fade-in-up"
>
  {/* Profile Card */}
  <div
    class="backdrop-blur-3xl bg-linear-to-br flex flex-col lg:flex-row gap-6 md:gap-8 lg:gap-10 xl:gap-12 from-white/40 to-white/20
        border border-white/50 rounded-2xl md:rounded-3xl p-6 md:p-7 lg:p-8 shadow-2xl"
  >
    {/* Left Content */}
    <div class="w-full lg:w-auto lg:shrink-0">
      {/* Top content */}
      <ProfileHeader locale={locale} />

      {/* CTA */}
      <AboutCTA locale={locale} />
    </div>

    {/* Right Content */}
    <div
      class="bg-white/20 w-full lg:flex-1 lg:min-w-0 rounded-xl md:rounded-2xl p-5 md:p-6 backdrop-blur-sm border border-white/30 flex flex-col"
    >
      {/* About Me Box */}
      <div class="space-y-3 flex-1">
        {/* Header */}
        <div class="flex items-center gap-2">
          <Code2 className="w-5 h-5 text-blue-600 shrink-0" />
          <h3 class="text-lg md:text-xl font-bold text-neutral-900">
            {t.title}
          </h3>
        </div>

        {/* Paragraphs */}
        <p class="text-sm md:text-base text-neutral-700 leading-relaxed">
          {t.paragraph1}
        </p>

        <p class="text-sm md:text-base text-neutral-700 leading-relaxed">
          {t.paragraph2}
        </p>
      </div>

      {/* Professional signals */}
      <div class="flex flex-wrap gap-3 md:gap-4 mt-6">
        <div
          class="flex items-center gap-2 text-xs md:text-sm font-medium text-neutral-800"
        >
          <ShieldCheck className="w-4 h-4 text-blue-600 shrink-0" />
          <span class="whitespace-nowrap">{t.reliability}</span>
        </div>

        <div
          class="flex items-center gap-2 text-xs md:text-sm font-medium text-neutral-800"
        >
          <Layers className="w-4 h-4 text-blue-600 shrink-0" />
          <span class="whitespace-nowrap">{t.longTermThinking}</span>
        </div>

        <div
          class="flex items-center gap-2 text-xs md:text-sm font-medium text-neutral-800"
        >
          <UserCheck className="w-4 h-4 text-blue-600 shrink-0" />
          <span class="whitespace-nowrap">{t.userCentered}</span>
        </div>
      </div>
    </div>
  </div>

  {/* Quick Stats */}
  <div class="grid grid-cols-1 sm:grid-cols-2 mt-6 gap-4 md:gap-5 lg:gap-6">
    <div
      class="backdrop-blur-xl bg-white/30 border border-white/50 rounded-xl md:rounded-2xl p-5 md:p-6 text-center"
    >
      <TechStackCarousel
        client:visible
        techStack={backendTechStack}
        title={t.backendTools}
        iconName="layers"
      />
    </div>
    <div
      class="backdrop-blur-xl bg-white/30 border border-white/50 rounded-xl md:rounded-2xl p-5 md:p-6 text-center"
    >
      <TechStackCarousel
        client:visible
        techStack={frontendTechStack}
        title={t.frontend}
        iconName="monitor"
      />
    </div>
  </div>
</section>
