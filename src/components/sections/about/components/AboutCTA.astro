---
import { Button } from "@/components/ui/moving-border";
import { Button as ShadcnButton } from "@/components/ui/button";
import { ArrowRight, Download } from "lucide-react";
import cvEs from "@/assets/about-me/CV_Cristobal_Coronel_Chambe.pdf";
import cvEn from "@/assets/about-me/CV_Cristobal_Coronel_English.pdf";
import { scrollToSection } from "@/utils/scrollToSection";
import { normalizeLocale } from "@/i18n/config";
import type { Locale } from "@/i18n/types";

interface Props {
  locale?: Locale;
}

const locale = normalizeLocale(Astro.props.locale);
const cv = locale === "en" ? cvEn : cvEs;
const t =
  locale === "es"
    ? {
        viewProjects: "Ver proyectos",
        downloadCv: "Descargar CV",
      }
    : {
        viewProjects: "Projects",
        downloadCv: "Download resume",
      };
---

<div
  class="items-center flex flex-col md:flex-row w-full md:w-85 gap-2 md:gap-3 py-3 md:py-0"
>
  <Button
    client:visible
    borderRadius="0.75rem"
    duration={2000}
    containerClassName="h-11 w-full md:w-auto explore-btn-trigger"
    className="bg-white/40 backdrop-blur-xl border-white/60 text-blue-950 font-bold hover:bg-white/50 hover:shadow-2xl hover:shadow-blue-400/40 transition-all duration-300 hover:scale-[1.02] w-full md:w-auto"
  >
    <span class="flex items-center justify-center gap-2 group px-4">
      {t.viewProjects}
      <ArrowRight
        className="h-4 w-4 group-hover:translate-x-1 transition-transform"
      />
    </span>
  </Button>
  <a
    href={cv}
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center justify-center
  w-full md:w-auto"
  >
    <ShadcnButton
      size="lg"
      variant="outline"
      className="border border-blue-200 hover:bg-blue-50 dark:hover:bg-blue-900/20 backdrop-blur-sm bg-white/30 transition-all duration-300 hover:-translate-y-0.5 group w-full md:w-auto"
    >
      <Download
        className="mr-2 h-4 w-4 group-hover:translate-y-0.5 transition-transform"
      />
      {t.downloadCv}
    </ShadcnButton>
  </a>

  <script>
    import { scrollToSection } from "@/utils/scrollToSection";
    document
      .querySelector(".explore-btn-trigger")
      ?.addEventListener("click", () => {
        scrollToSection("#projects");
      });
  </script>
</div>
