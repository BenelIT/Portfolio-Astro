---
import { MapPin } from "lucide-react";
import SocialLinks from "./SocialLinks.astro";
---

<div class="flex h-40 gap-4">
  {/* Avatar placeholder */}
  <div class="relative mb-6">
    <div
      class="rounded-full bg-linear-to-br from-blue-400 via-blue-600 to-blue-950 p-0.75"
    >
      <div class="rounded-full overflow-hidden w-35 h-35 bg-white">
        <img
          src="/src/assets/about-me/img1.JPEG"
          alt="Cristobal"
          class="w-full h-full object-cover object-top"
        />
      </div>
    </div>
  </div>

  {/* Personal Info */}
  <div class="mt-5">
    <h3 class="text-2xl font-bold text-neutral-900 leading-tight">
      Cristóbal Coronel
    </h3>

    <p class="text-blue-600 font-semibold">Full-Stack Developer</p>

    {/* Location */}
    <div class="flex items-center gap-1 text-sm text-neutral-600">
      <MapPin className="w-3.5 h-3.5" />
      <span>Chiapas, Mexico</span>
    </div>

    {/* Social Links */}
    <SocialLinks />
  </div>
</div>
